# Copy to .env for local development or configure these as Replit Secrets.
# Never commit a real token, password, encryption key, database, or payment screenshot.
BOT_TOKEN=
FERNET_KEY=
ADMIN_CHAT_IDS=
D17_DESTINATION=
EDINAR_DESTINATION=
BANK_DESTINATION=

# Live admin website. This default URL and selectors came from the included tested flow.
# Override the URLs/selectors if the site changes.
ADMIN_BASE_URL=https://mycard.doblobet.com
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TIMEOUT_MS=15000
ADMIN_LOGIN_URL=https://mycard.doblobet.com/login
ADMIN_CREATE_USER_URL=https://mycard.doblobet.com/user-create
ADMIN_USERS_LIST_URL=https://mycard.doblobet.com/users-list
ADMIN_LOGIN_USER_SELECTOR=input[type="text"]
ADMIN_LOGIN_PASSWORD_SELECTOR=input[type="password"]
ADMIN_LOGIN_SUBMIT_SELECTOR=#root > div > section > div.auth__bottom > div
ADMIN_CREATE_USERNAME_SELECTOR=input[placeholder="Username"]
ADMIN_CREATE_PASSWORD_SELECTOR=input[placeholder="Password"]
# Set this only if the account form requires a phone field.
ADMIN_CREATE_PHONE_SELECTOR=
ADMIN_CREATE_SUBMIT_SELECTOR=.create-user__button
ADMIN_CREATE_SUCCESS_TEXT=Create success
ADMIN_USER_SEARCH_SELECTOR=input[type="text"]
ADMIN_USER_LINK_SELECTOR=#root > div > div.users-list > div.users-list__list > a
ADMIN_BALANCE_SELECTOR=#root > div > div.user-edit > div.user-edit__info > div:nth-child(3) > div.user-edit__value
ADMIN_TOPUP_AMOUNT_SELECTOR=#root > div > div.user-edit > div.user-edit__payment-block > div:nth-child(1) > input
ADMIN_TOPUP_SUBMIT_SELECTOR=#root > div > div.user-edit > div.user-edit__payment-block > div.user-edit__payment-button

# Payment verifier site. Fill these with the exact form and result selectors.
VERIFIER_BASE_URL=
VERIFIER_LOGIN_URL=
VERIFIER_FORM_URL=
VERIFIER_USERNAME=
VERIFIER_PASSWORD=
VERIFIER_TIMEOUT_MS=30000
VERIFIER_LOGIN_USER_SELECTOR=
VERIFIER_LOGIN_PASSWORD_SELECTOR=
VERIFIER_LOGIN_SUBMIT_SELECTOR=
VERIFIER_LOGGED_IN_SELECTOR=
VERIFIER_FILE_INPUT_SELECTOR=
VERIFIER_PHONE_INPUT_SELECTOR=
VERIFIER_REFERENCE_INPUT_SELECTOR=
VERIFIER_SUBMIT_SELECTOR=
VERIFIER_STATUS_SELECTOR=
VERIFIER_AMOUNT_SELECTOR=
VERIFIER_RESULT_PHONE_SELECTOR=
VERIFIER_RESULT_REFERENCE_SELECTOR=
VERIFIER_TRANSACTION_ID_SELECTOR=
# Status values are exact, case-insensitive matches—not substring matches.
VERIFIER_SUCCESS_TEXTS=SUCCESS,APPROVED,VERIFIED
VERIFIER_FAILURE_TEXTS=FAILED,FAIL,REJECTED,DECLINED,INVALID,NOT FOUND,NOT SUCCESSFUL,NOT APPROVED,UNSUCCESSFUL,NOT VERIFIED

# Live test mode: this project defaults to real balance changes after every check passes.
# Set DRY_RUN=true to verify a payment without changing the admin balance.
DRY_RUN=false
MIN_DEPOSIT=1
MAX_DEPOSIT=1
MAX_UPLOAD_MB=10
DB_PATH=./data/agent.db
UPLOAD_DIR=./data/uploads
HEADLESS=true
