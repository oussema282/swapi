# Copy this file to bot/.env. Never commit bot/.env.

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_token_from_botfather
# Numeric IDs only, separated by commas. Use a trusted Telegram ID lookup first.
TELEGRAM_ADMIN_IDS=123456789

# Game administrator login
GAME_BASE_URL=https://game.example.com
GAME_LOGIN_URL=https://game.example.com/login
GAME_ADMIN_USERNAME=replace_with_admin_username
GAME_ADMIN_PASSWORD=replace_with_admin_password

# Playwright selectors: replace every example with a selector from your website.
# Prefer stable #ids or [data-testid="..."] selectors.
GAME_LOGIN_USERNAME_SELECTOR=#login-username
GAME_LOGIN_PASSWORD_SELECTOR=#login-password
GAME_LOGIN_SUBMIT_SELECTOR=button[type="submit"]
# Must become visible only after a successful login.
GAME_LOGIN_SUCCESS_SELECTOR=[data-testid="admin-dashboard"]

GAME_CASH_REGISTER_SELECTOR=[data-testid="cash-register"]

GAME_CREATE_USER_SELECTOR=[data-testid="new-user"]
GAME_CREATE_USERNAME_SELECTOR=#new-user-username
GAME_CREATE_PASSWORD_SELECTOR=#new-user-password
# Leave empty if the form has no password confirmation field.
GAME_CREATE_CONFIRM_PASSWORD_SELECTOR=#new-user-password-confirm
GAME_CREATE_SUBMIT_SELECTOR=[data-testid="create-user-submit"]
# Must become visible only when creation succeeds.
GAME_CREATE_SUCCESS_SELECTOR=[data-testid="create-user-success"]

GAME_DEPOSIT_SELECTOR=[data-testid="deposit"]
GAME_DEPOSIT_USERNAME_SELECTOR=#deposit-username
GAME_DEPOSIT_AMOUNT_SELECTOR=#deposit-amount
GAME_DEPOSIT_SUBMIT_SELECTOR=[data-testid="deposit-submit"]
GAME_DEPOSIT_SUCCESS_SELECTOR=[data-testid="deposit-success"]

GAME_WITHDRAW_SELECTOR=[data-testid="withdraw"]
GAME_WITHDRAW_USERNAME_SELECTOR=#withdraw-username
GAME_WITHDRAW_AMOUNT_SELECTOR=#withdraw-amount
GAME_WITHDRAW_SUBMIT_SELECTOR=[data-testid="withdraw-submit"]
GAME_WITHDRAW_SUCCESS_SELECTOR=[data-testid="withdraw-success"]

GAME_CHANGE_PASSWORD_SELECTOR=[data-testid="change-password"]
GAME_CHANGE_PASSWORD_USERNAME_SELECTOR=#password-username
GAME_CHANGE_PASSWORD_NEW_SELECTOR=#password-new
# Leave empty if the form has no confirmation field.
GAME_CHANGE_PASSWORD_CONFIRM_SELECTOR=#password-confirm
GAME_CHANGE_PASSWORD_SUBMIT_SELECTOR=[data-testid="password-submit"]
GAME_CHANGE_PASSWORD_SUCCESS_SELECTOR=[data-testid="password-success"]

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
BROWSER_SLOW_MO_MS=0
# Screenshots can contain private data. Keep false except during controlled debugging.
SAVE_FAILURE_SCREENSHOTS=false

# Bot rules
MIN_TRANSACTION_AMOUNT=0.01
MAX_TRANSACTION_AMOUNT=100000.00
GAME_USERNAME_PATTERN=[A-Za-z][A-Za-z0-9_]{2,19}

# Defaults are bot/data and bot/artifacts. Use absolute paths in production if desired.
# DOODY_DATA_DIR=/opt/shop-simulator-bot/data
# BOT_ARTIFACT_DIR=/opt/shop-simulator-bot/artifacts
